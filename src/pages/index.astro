---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import PricingSection from '../components/PricingSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Footer from '../components/Footer.astro';
import TrialModal from '../components/TrialModal.astro';
---

<MainLayout
  title="XuperPlay - Streaming en Vivo, Películas y Series sin Límites"
  description="Disfruta de +1000 canales en vivo, películas, series y contenido on-demand en todos tus dispositivos Android. Planes desde $9/mes con XuperPlay."
>
  <Header />
  <main>
    <HeroCarousel />
    <FeaturesGrid />
    <PricingSection />
    <FAQAccordion />
  </main>
  <Footer />
  <TrialModal />
</MainLayout>

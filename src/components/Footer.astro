---
import { Image } from 'astro:assets';
import logoImage from '../assets/images/logos/Xuper_play_logo.webp';

const currentYear = new Date().getFullYear();

const footerLinks = {
  producto: [
    { name: 'Características', href: '/#caracteristicas' },
    { name: 'Planes y Precios', href: '/#planes' },
    { name: 'Descargas', href: '/#descargar' },
  ],
  soporte: [
    { name: 'Centro de Ayuda', href: '/#faqs' },
    { name: 'Guía de Instalación', href: '/instalacion' },
    { name: 'Contacto', href: '/#contacto' },
  ],
};
---

<footer id="contacto" class="bg-gray-900 text-gray-300">
  <!-- Main Footer Content -->
  <div class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand Section -->
      <div class="lg:col-span-2">
        <div class="mb-6">
          <Image src={logoImage} alt="XuperPlay" class="h-12 w-auto mb-4" loading="lazy" />
          <p class="text-gray-400 mt-4 leading-relaxed">
            Tu plataforma de streaming favorita con miles de canales en vivo, películas, series y contenido on-demand. Entretenimiento sin límites, donde quieras, cuando quieras.
          </p>
        </div>

        <!-- Contact Info -->
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary-500">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <a
              href="https://wa.me/573014034646?text=Hola%2C%20quiero%20más%20información%20sobre%20XuperPlay"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              Escríbenos por WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Links Columns -->
      <div>
        <h4 class="text-white font-bold text-lg mb-4">Producto</h4>
        <ul class="space-y-2">
          {footerLinks.producto.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold text-lg mb-4">Soporte</h4>
        <ul class="space-y-2">
          {footerLinks.soporte.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-gray-800">
    <div class="container mx-auto px-4 py-6">
      <p class="text-gray-500 text-sm text-center">
        &copy; {currentYear} XuperPlay. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
